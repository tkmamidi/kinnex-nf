/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM executor configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor       = 'slurm'

    // Uncomment and modify as needed for your cluster
    // queue          = 'your_partition'
    clusterOptions = '--exclude=D48-16'

    // Use scratch directory on compute nodes
    // scratch = true
}

// SLURM-specific settings
executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
    pollInterval    = '30 sec'
}
