/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Kinnex IsoSeq Pipeline - Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params
params {
    // ----------------
    // INPUT/OUTPUT
    // ----------------
    input                  = null        // Path to samplesheet CSV
    outdir                 = './results'
    publish_dir_mode       = 'copy'      // 'copy', 'symlink', 'link'

    // ----------------
    // REFERENCE FILES
    // ----------------
    genome                 = 'GRCh38'    // Genome key for preset references
    ref_genome             = null        // Override: path to reference genome FASTA
    ref_annotation         = null        // Override: path to annotation GTF
    mas8_primers           = null        // MAS8 primers FASTA for segmentation
    isoseq_primers         = null        // IsoSeq primers FASTA for lima/refine

    // ----------------
    // TOOL OPTIONS
    // ----------------
    // Skera (segmentation)
    skera_extra_args       = ''

    // Lima (demultiplexing)
    lima_extra_args        = '--isoseq --peek-guess'

    // IsoSeq refine
    isoseq_refine_extra_args  = ''

    // IsoSeq cluster
    isoseq_cluster_extra_args = ''

    // pbmm2 alignment
    pbmm2_preset           = 'ISOSEQ'
    pbmm2_extra_args       = '--sort'

    // IsoSeq collapse
    isoseq_collapse_extra_args = '--do-not-collapse-extra-5exons'

    // Pigeon
    pigeon_classify_extra_args = ''
    pigeon_filter_extra_args   = ''
    pigeon_report_extra_args   = '--exclude-singletons'  // Required for pigeon >= 1.4.0

    // ----------------
    // WORKFLOW OPTIONS
    // ----------------
    skip_segmentation      = false       // Skip if BAMs are already segmented
    skip_pigeon            = false       // Stop after isoseq collapse

    // ----------------
    // RESOURCE LIMITS
    // ----------------
    max_cpus               = 48
    max_memory             = '180.GB'
    max_time               = '72.h'

    // ----------------
    // ENVIRONMENT
    // ----------------
    conda_env              = '/analysis/cloud_projects/research/cancer/scKinnex/scKinnex_20250418.yml'        // Path to existing conda environment
    tmpdir                 = null        // Custom TMPDIR path
}

// Load config files
includeConfig 'conf/base.config'
includeConfig 'conf/genomes.config'
includeConfig 'conf/modules.config'

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }

    conda {
        conda.enabled           = true
        conda.cacheDir          = "${HOME}/.nextflow/conda"
        docker.enabled          = false
        singularity.enabled     = false
        process.conda           = "${projectDir}/assets/scKinnex_simple.yml"
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        params.max_cpus         = 4
        params.max_memory       = '8.GB'
        params.max_time         = '1.h'
    }
}

// Environment variables
env {
    PYTHONNOUSERSITE = 1
    PYTHONPATH       = null
    PYTHONHOME       = null
}

// Set TMPDIR if specified
if (params.tmpdir) {
    env.TMPDIR       = params.tmpdir
    env.SLURM_TMPDIR = params.tmpdir
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Execution reports
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
}

// Export these functions to the workflow scope
def checkPathExists(path, description) {
    if (path && !file(path).exists()) {
        error "ERROR: ${description} file not found: ${path}"
    }
}

// Manifest
manifest {
    name            = 'kinnex-nf'
    author          = 'Your Name'
    homePage        = 'https://github.com/your-org/kinnex-nf'
    description     = 'Nextflow pipeline for PacBio Kinnex/MAS-Seq IsoSeq analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
